{
  "name": "mordu-sport-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "tunnel": "expo start --tunnel",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "ota:prod:ios": "npx eas update --channel production --platform ios",
    "ota:prod:android": "npx eas update --channel production --platform android",
    "ota:dev:ios": "npx eas update --channel development --platform ios",
    "ota:dev:android": "npx eas update --channel development --platform android",
    "build:dev:ios": "npx eas build --profile development --platform ios",
    "build:dev:android": "npx eas build --profile development --platform android",
    "build:prod:ios": "npx eas build --profile production --platform ios",
    "build:prod:android": "npx eas build --profile production --platform android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@giphy/react-native-sdk": "^5.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.90.1",
    "@tanstack/react-query": "^5.90.17",
    "date-fns": "^4.1.0",
    "expo": "~54.0.13",
    "expo-constants": "~18.0.9",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.9",
    "expo-linking": "~8.0.8",
    "expo-router": "~6.0.11",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.7",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.8",
    "fast-xml-parser": "^5.3.3",
    "lucide-react-native": "^0.546.0",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-mobile-ads": "^16.3.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.14.0",
    "react-native-svg-transformer": "^1.5.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.18"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
