{
  "expo": {
    "name": "Ultra Sports Fans",
    "slug": "mordu-sport-mobile",
    "version": "1.1.8",
    "runtimeVersion": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "ultrasportsfans",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jostinjarry1.mordusportmobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "SKAdNetworkItems": [
          {
            "SKAdNetworkIdentifier": "cstr6suwn9.skadnetwork"
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0d0d0d",
        "foregroundImage": "./assets/images/app-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ultrasportsfans.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/usflogo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/usflogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0d0d0d",
          "dark": {
            "backgroundColor": "#0d0d0d"
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5165277705756059~7412095548",
          "iosAppId": "ca-app-pub-5165277705756059~3315021170",
          "userTrackingUsageDescription": "This identifier will be used to deliver personalized ads to you."
        }
      ],
      [
        "onesignal-expo-plugin",
        {
          "mode": "production",
          "appGroupName": "group.com.jostinjarry1.mordusportmobile"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "updates": {
      "url": "https://u.expo.dev/3d28962e-baf2-47a7-a257-6a17487a0705"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3d28962e-baf2-47a7-a257-6a17487a0705"
      }
    }
  }
}