{
  "expo": {
    "name": "Ultra Sports Fans",
    "slug": "mordu-sport-mobile",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/usflogo.png",
    "scheme": "mordusportmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jostinjarry1.mordusportmobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0d0d0d",
        "foregroundImage": "./assets/images/usflogo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.jostinjarry1.mordusportmobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/usflogo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/usflogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0d0d0d",
          "dark": {
            "backgroundColor": "#0d0d0d"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3d28962e-baf2-47a7-a257-6a17487a0705"
      }
    }
  }
}
